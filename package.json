{
  "name": "apex-intel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "npm run data:audit && npm run typecheck && webpack --mode production",
    "preview": "python3 -m http.server 4173 --directory dist",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run data:audit && npm run typecheck",
    "data:audit": "node scripts/audit-data.cjs",
    "data:generate": "python3 scripts/generate-data.py",
    "media:sync": "python3 scripts/sync-media.py"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "wouter": "3.7.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.28.3",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "babel-loader": "10.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.4",
    "mini-css-extract-plugin": "2.9.4",
    "typescript": "5.9.2",
    "webpack": "5.109.2",
    "webpack-cli": "6.0.1"
  }
}
